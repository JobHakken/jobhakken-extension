{
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "optional_permissions": [],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://app.jobhakken.com/*",
    "https://www.google-analytics.com/*"
  ],
  "optional_host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.deepseek.com/*",
    "https://api.fireworks.ai/*",
    "https://api.groq.com/*",
    "https://api.mistral.ai/*",
    "https://api.openai.com/*",
    "https://api.perplexity.ai/*",
    "https://api.together.xyz/*",
    "https://api.x.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://open.bigmodel.cn/*",
    "https://openrouter.ai/*"
  ],
  "content_scripts_matches": ["<all_urls>", "https://app.jobhakken.com/*"],
  "content_scripts_all_frames": true,
  "web_accessible_resources": "[{\"resources\":[\"content/pageBridge.js\"],\"matches\":[\"<all_urls>\"]}]",
  "externally_connectable": "{\"matches\":[\"https://jobhakken.com/*\",\"https://www.jobhakken.com/*\",\"https://app.jobhakken.com/*\"]}"
}
