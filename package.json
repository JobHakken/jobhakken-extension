{
  "name": "jobhakken-extension",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node build.mjs",
    "package": "node build.mjs && cd dist && rm -f ../jobhakken-extension.zip && zip -qr ../jobhakken-extension.zip . && cd .. && echo \"packaged → jobhakken-extension.zip (upload this to the Chrome Web Store)\"",
    "test": "jest --config ./jest.config.ts"
  },
  "dependencies": {
    "@jobhakken/autofill": "^0.1.0",
    "@jobhakken/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "esbuild": "^0.25.2",
    "jest": "^29.7.0",
    "sharp": "^0.34.5",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
