{
  "manifest_version": 3,
  "name": "JobHakken \u2014 Apply Copilot",
  "version": "0.36.1",
  "description": "Autofill job applications smartly, with a job-description match, H-1B/UK visa signal, and a r\u00e9sum\u00e9 tailored for the job.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "action": {
    "default_title": "JobHakken",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://app.jobhakken.com/*"],
      "js": ["content/auth.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "autofill": {
      "suggested_key": {
        "default": "Ctrl+Shift+2",
        "mac": "MacCtrl+2"
      },
      "description": "Autofill this application"
    }
  },
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting"],
  "externally_connectable": {
    "matches": ["https://jobhakken.com/*", "https://www.jobhakken.com/*", "https://app.jobhakken.com/*"]
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://api.anthropic.com/*",
    "https://api.deepseek.com/*",
    "https://api.fireworks.ai/*",
    "https://api.groq.com/*",
    "https://api.mistral.ai/*",
    "https://api.openai.com/*",
    "https://api.perplexity.ai/*",
    "https://api.together.xyz/*",
    "https://api.x.ai/*",
    "https://app.jobhakken.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://open.bigmodel.cn/*",
    "https://openrouter.ai/*",
    "https://www.google-analytics.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/pageBridge.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
