{
  "manifest_version": 3,
  "name": "First2Apply — Apply Copilot",
  "version": "0.5.2",
  "description": "Autofill job applications smartly, with a live ATS match, H-1B/UK visa signal, and a résumé tailored for the job.",
  "background": { "service_worker": "background/serviceWorker.js", "type": "module" },
  "options_page": "options/options.html",
  "action": { "default_title": "First2Apply", "default_popup": "popup/popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "autofill": {
      "suggested_key": { "default": "Ctrl+Shift+2", "mac": "MacCtrl+2" },
      "description": "Autofill this application"
    }
  },
  "permissions": ["storage", "unlimitedStorage", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"]
}
